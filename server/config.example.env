# Copy values into the project .env when your gateways are ready.
# Email endpoint: POST {to, subject, text}; respond with HTTP 2xx after accepting delivery.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
# Push endpoint: POST {id, userId, title, body, devices:[{token, platform}]}.
# Deduplicate by id. Non-2xx triggers retries (up to 5 attempts); empty URL keeps push pending.
# The mobile push SDK can register tokens through POST /api/notifications/devices.
PUSH_WEBHOOK_URL=
PUSH_WEBHOOK_TOKEN=
